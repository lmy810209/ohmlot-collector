# Copy to .env.local for local development. Both values come from your Supabase project settings
# (Project Settings -> API) after running supabase/migrations/0001_subscribers.sql against it.
#
# NEXT_PUBLIC_* vars are bundled into client-side JS and visible to anyone who views source — that's
# expected for the anon key here (task-prelaunch.md §B): RLS on `subscribers` denies anon everything, and
# the anon key's only real capability is EXECUTE on the subscribe()/unsubscribe() functions. Never put the
# service_role key (or anything else meant to stay secret) behind a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
