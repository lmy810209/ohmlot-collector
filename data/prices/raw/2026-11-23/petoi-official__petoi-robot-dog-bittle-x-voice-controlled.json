muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/d658b5d12b724f7fab5ec1b4ef984088.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eWhat's Included\u003c\/h3\u003e\n\u003cp\u003e\u003cimg alt=\"Bittle X V2 package contents: pre-assembled, construction kit and Bittle X V2+Arm pre-assembled\" style=\"display: block; margin-left: auto; margin-right: auto;\" class=\"lazyload\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/Bittle_robot_dog_package_content_comparison_-_landscape_e67c937e-64bd-492c-9c16-6b79269de927.jpg?v=1794801581\u0026amp;width=1024\"\u003e\u003c\/p\u003e\n\u003ch3\u003eComparison of Bittle X Packages\u003c\/h3\u003e\n\u003cp\u003e\u003ca href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/Petoi_Bittle_X_family_comparison_robot_dog_robot_arm_kits_v3.png?v=1764741602\" target=\"_blank\"\u003e \u003cimg class=\"kai-product-desc-img lazyload\" alt=\"Comparison of Bittle X V2 robot dog and robotic arm kit options\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/Petoi_Bittle_X_family_comparison_robot_dog_robot_arm_kits_v3.png?v=1764741602\" height=\"auto\" width=\"1024\"\u003e \u003c\/a\u003e\u003c\/p\u003e\n\u003ch6\u003e Note: if you want to add \u003ca href=\"\/products\/bittle-arm-extension-with-metal-servos\" target=\"_blank\"\u003ePetoi robotics arm extension\u003c\/a\u003e later, you need to get the alloy servo version. The lite servo version doesn't have enough power to drive the extra weight added by the arm extension.\u003c\/h6\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eIntuitive Control for Lifelike Behaviors\u003c\/h3\u003e\n\u003ch5 class=\"kai-product-desc-center\" style=\"text-align: center;\"\u003ePlay with Petoi Mobile App supporting 35+ built-in commands\u003c\/h5\u003e\n\u003cdiv class=\"kai-product-desc-center\"\u003e\u003cimg alt=\"Control Petoi Robot Dog Bittle to perform many actions with mobile app, or voice\" class=\"lazyload\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/bittle_x_remote_control_mobile_app_1024x1024.jpg?v=1743404842\" style=\"display: block; margin-left: auto; margin-right: auto;\"\u003e\u003c\/div\u003e\n\u003cdiv class=\"kai-product-desc-center\"\u003eNote: some prior coding experience in Scratch, C++ or Python is highly desirable. Kids under 10 can enjoy building and coding Bittle X with adult supervision.\u003cbr\u003e\n\u003c\/div\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eTrain Bittle X with Voice Commands\u003cbr\u003e\n\u003c\/h3\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003e\u003ca href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/petoi_bittle_x_robot_dog_voice_commands_1024x1024.jpg?v=1687231851\" class=\"text_lightbox\"\u003e35+ predefined\u003c\/a\u003e and 10 additional programmable commands\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"kai-product-desc-center\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/9f39b99238d24b088acc3722c12c5aee.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eProgram Bittle X for Realistic, Articulated Movements\u003c\/h3\u003e\n\u003cp class=\"kai-product-desc-center\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/368d0a103dc848e8ab77ac2555aee002.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\n\u003ch3 class=\"kai-product-desc-center\"\u003eHuman-Guided Robotics Skill Creation\u003c\/h3\u003e\n\u003ch4 class=\"kai-product-desc-center\"\u003efor Bittle X V2 \u0026amp; Bittle X V2+Arm, Leveraging Feedback Servos\u003c\/h4\u003e\n\u003cp class=\"kai-product-desc-center\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/fae258e678a94a8db7ce97bc85940d48.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\n\u003ch3 class=\"kai-product-desc-center\"\u003eSmart Adorable Responses via Built-in Sensors\u003c\/h3\u003e\n\u003ch4 class=\"kai-product-desc-center\"\u003eProgram new interaction based on built-in sensors\u003c\/h4\u003e\n\u003cp class=\"kai-product-desc-center\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/ea476f96b02540228b7e7a91d467f9bc.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\u003ch6\u003eThe gyroscope sensor is available for all Bittle X models.  The back touch sensor is only available for Bittle X V2 \u0026amp; Bittle X V2+Arm.\u003c\/h6\u003e\n\n\n\u003ch3 class=\"kai-product-desc-head3\"\u003eSimplify Robotics Education with Hands-on AI \u0026amp; IoT Projects Using Quadruped Robot Dogs\u003c\/h3\u003e\n\u003cp class=\"kai-product-desc-p2\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/eae5702e866b453eb0a2aac76c2ca0ee.mp4\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\u003ch6\u003e Note: our optional \u003ca href=\"\/products\/petoi-ai-vision-module-for-arduino\" target=\"_blank\"\u003ePetoi AI vision module\u003c\/a\u003e or \u003ca href=\"\/products\/petoi-sensor-pack\" target=\"_blank\"\u003ethe sensor pack\u003c\/a\u003e is required for object detection and tracking.\u003c\/h6\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eA Robotics Kit with So Many Possibilities for STEM, and Robotics Education!\u003c\/h3\u003e\n\u003ch5 class=\"kai-product-desc-center\" style=\"text-align: center;\"\u003eFor K12 school\/college educators, students, engineers, programmers, hackers, and makers like you\u003c\/h5\u003e\n\u003cp class=\"kai-product-desc-center\"\u003e\u003cvideo muted=\"\" playsinline=\"\" autoplay=\"autoplay\" loop=\"loop\" controls=\"controls\" data-height=\"0\" data-width=\"0\" preload=\"none\" class=\"video lazyload\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/BittleAssembly_1024x576_2x_speed_2990005b-ae93-4bf5-8205-36685ae4ab01.mp4?v=1637202831\"\u003e\u003c\/video\u003e\u003c\/p\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eC++, Python \u0026amp; Scratch-like Block-based Coding Support\u003c\/h3\u003e\n\u003ch5 class=\"kai-product-desc-center\" style=\"text-align: center;\"\u003eCode with blocks in your browser (\u003ca href=\"https:\/\/code.petoi.com\" target=\"_blank\"\u003ePetoi Web Coding Blocks\u003c\/a\u003e) or on iPhone and iPad (the free \u003ca href=\"https:\/\/apps.apple.com\/us\/app\/petoi-portal\/id6760995941\" target=\"_blank\"\u003ePetoi Portal\u003c\/a\u003e app), then move up to Python and C++. Free project-based \u003ca href=\"\/pages\/free-quadruped-robotics-curriculum-scratch-coding\" target=\"_blank\"\u003eblock coding\u003c\/a\u003e and \u003ca href=\"\/pages\/free-cplusplus-quadruped-robotics-curriculum\" target=\"_blank\"\u003eC++\u003c\/a\u003e curriculums included.\u003c\/h5\u003e\n\u003cdiv class=\"kai-product-desc-center\"\u003e\u003cimg alt=\"Learn robotics with free block-based coding and c++ curriculums with Petoi Bittle X robot dog\" class=\"lazyload\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/bittle_x_programming_support_-_block-based_c_python_1280px_8ee28be1-6d0c-4a8d-b230-2b54d3f30566.jpg?v=1699382237\u0026amp;width=900\" height=\"auto\" width=\"1024\"\u003e\u003c\/div\u003e\n\u003ch3\u003e\n\u003ca href=\"\/collections\/bittle-x-accessories\" target=\"_blank\"\u003eOptional Accessories\u003c\/a\u003e to Unlock New Ways to Interact with Petoi Robots\u003c\/h3\u003e\n\u003cp\u003e\u003ca href=\"\/collections\/bittle-x-accessories\" target=\"_blank\"\u003e \u003cimg class=\"kai-product-desc-img lazyload\" alt=\"Bittle X coding robot dog with Petoi sensor pack and camera optional accessories\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/Bittle_AI_head_sensor_ai_vison_module_-_Motion_Sensors_-_desktop_1024x1024.jpg?v=1794542318\" height=\"auto\" width=\"1024\"\u003e \u003c\/a\u003e\u003c\/p\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eHighly Extensible with Raspberry Pi \u0026amp; Arduino Ecosystem\u003c\/h3\u003e\n\u003cdiv class=\"kai-product-desc-center custom-image-center\"\u003e\u003cimg alt=\"Program Petoi Robot Dog Bittle with Raspberry Pi\" class=\"lazyload\" data-src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0550\/2015\/9160\/files\/petoi_bittle_raspberry_pi_on_the_right_with_text_1024x1024.jpg?v=1713051810\" height=\"auto\" width=\"1024\"\u003e\u003c\/div\u003e\n\u003ch6 class=\"kai-product-desc-center\"\u003eNote: Raspberry Pi not included.\u003c\/h6\u003e\n\u003ch3 class=\"kai-product-desc-center\"\u003eHands-On Physical AI with Bittle X V2\u003c\/h3\u003e\n\u003cp class=\"kai-product-desc-center\" style=\"text-align: center; font-size: 20px; font-weight: 500; color: rgb(18, 18, 18);\"\u003ePhysical AI is AI that senses and moves in the real world. Bittle X V2 gives you a real four-legged robot to try it on: people have connected Petoi robots to language models, cameras and reinforcement learning. These are community projects, not built-in features.\u003c\/p\u003e\n\u003cstyle\u003e.petoi-ai-projects summary{list-style:none}.petoi-ai-projects summary::-webkit-details-marker{display:none}.petoi-ai-projects .petoi-chev{display:inline-block;transition:transform .2s}.petoi-ai-projects details[open] .petoi-chev{transform:rotate(180deg)}.petoi-ai-projects summary:hover{background:#eef6fb}\u003c\/style\u003e\n\u003csection class=\"petoi-ai-projects\" style=\"max-width: 820px; margin: 0 auto;\"\u003e\n\u003cdetails style=\"margin: 12px 0;\"\u003e\u003csummary style=\"cursor: pointer; text-align: center; font-size: 20px; font-weight: 500; color: rgb(18, 18, 18); padding: 14px 18px; border: 1px solid #d6d6d6; border-radius: 10px; background: #f6f8fa;\"\u003eBolt, an on-device AI companion (AGI House Gemma hackathon team) \u003cspan style=\"color: #0088cc; font-size: 0.8em; white-space: nowrap;\"\u003eDetails \u003cspan class=\"petoi-chev\"\u003e▾\u003c\/span\u003e\u003c\/span\u003e\u003c\/summary\u003e\u003cp style=\"padding: 6px 18px 0; text-align: center; font-size: 16px; font-weight: 300; line-height: 1.8;\"\u003eAn iPhone app where Google's Gemma runs on the phone, reads live heart rate from a Bluetooth band and sends the robot its moves (wave, walk, flip). Nothing goes to a server. Built on Petoi's Quaddle. The same idea (a phone running Gemma as the robot's brain) could be ported to Bittle X V2: Petoi's \u003ca href=\"https:\/\/github.com\/PetoiCamp\/opencat-gemma\" target=\"_blank\"\u003eopencat-gemma\u003c\/a\u003e starter kit already runs Gemma on a phone or laptop to control Bittle X V2. \u003cem\u003eNeeds: an iPhone 15 Pro or newer; a Bluetooth heart-rate strap is optional.\u003c\/em\u003e \u003ca href=\"https:\/\/github.com\/abhinav30219\/boltpublic\" target=\"_blank\"\u003eSee the project →\u003c\/a\u003e · \u003ca href=\"https:\/\/www.petoi.com\/blogs\/blog\/gemma-on-device-physical-ai-robot-dog-hackathon\"\u003eRead the story →\u003c\/a\u003e\u003c\/p\u003e\u003c\/details\u003e\n\u003cdetails style=\"margin: 12px 0;\"\u003e\u003csummary style=\"cursor: pointer; text-align: center; font-size: 20px; font-weight: 500; color: rgb(18, 18, 18); padding: 14px 18px; border: 1px solid #d6d6d6; border-radius: 10px; background: #f6f8fa;\"\u003eFinoBot (CPE Lyon students) \u003cspan style=\"color: #0088cc; font-size: 0.8em; white-space: nowrap;\"\u003eDetails \u003cspan class=\"petoi-chev\"\u003e▾\u003c\/span\u003e\u003c\/span\u003e\u003c\/summary\u003e\u003cp style=\"padding: 6px 18px 0; text-align: center; font-size: 16px; font-weight: 300; line-height: 1.8;\"\u003eA Bittle X that understands voice commands and follows a person around the room. \u003cem\u003eNeeds: Raspberry Pi, camera, microphone, two 18650 batteries, ROS2.\u003c\/em\u003e \u003ca href=\"\/blogs\/blog\/finobot-ai-robot-dog-bittle-x-follows-someone\" target=\"_blank\"\u003eRead the story →\u003c\/a\u003e\u003c\/p\u003e\u003c\/details\u003e\n\u003cdetails style=\"margin: 12px 0;\"\u003e\u003csummary style=\"cursor: pointer; text-align: center; font-size: 20px; font-weight: 500; color: rgb(18, 18, 18); padding: 14px 18px; border: 1px solid #d6d6d6; border-radius: 10px; background: #f6f8fa;\"\u003eReinforcement learning (community) \u003cspan style=\"color: #0088cc; font-size: 0.8em; white-space: nowrap;\"\u003eDetails \u003cspan class=\"petoi-chev\"\u003e▾\u003c\/span\u003e\u003c\/span\u003e\u003c\/summary\u003e\u003cp style=\"padding: 6px 18px 0; text-align: center; font-size: 16px; font-weight: 300; line-height: 1.8;\"\u003eTrain walking gaits in simulation, then try them on a real robot. \u003ca href=\"\/blogs\/blog\/petoi-robot-ai-reinforcing-learning\" target=\"_blank\"\u003eRead the guide →\u003c\/a\u003e\u003c\/p\u003e\u003c\/details\u003e\n\u003c\/section\u003e\n\u003cp class=\"kai-product-desc-center\" style=\"text-align: center; font-size: 20px; font-weight: 500; color: rgb(18, 18, 18);\"\u003e\u003ca href=\"\/pages\/quadruped-physical-ai\"\u003eSee more physical AI projects →\u003c\/a\u003e\u003c\/p\u